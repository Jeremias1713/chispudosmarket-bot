# Integración oficial Dropanas: exclusivamente operaciones GET.
DROPANAS_API_ENABLED=false
DROPANAS_API_READ_ONLY_ACK=false
DROPANAS_API_TOKEN=
DROPANAS_API_BASE_URL=https://app.dropanas.com/api/v1
DROPANAS_API_TIMEOUT_MS=20000
DROPANAS_API_MAX_PAGES=1000

# La consulta manual del panel funciona sin polling. Active esto solo cuando
# haya verificado la primera línea base y quiera sincronización automática.
DROPANAS_API_POLL_ENABLED=false
DROPANAS_API_POLL_MINUTES=15

# Se genera al registrar https://SU-DOMINIO/dropanas/webhook en Dropanas.
DROPANAS_WEBHOOK_SECRET=

# Descarga de la imagen original de la etiqueta. Use una cuenta Dropanas
# dedicada y de permisos mínimos; nunca escriba estas credenciales en Git.
DROPANAS_GUIDE_ENABLED=false
DROPANAS_GUIDE_EMAIL=
DROPANAS_GUIDE_PASSWORD=
DROPANAS_GUIDE_TIMEOUT_MS=30000

# Envio sin confirmacion humana. Dejar false hasta completar una prueba al
# numero del negocio. Cuando esta true, solo envia con coincidencia unica de
# telefono; las coincidencias por nombre quedan pendientes en el panel.
DROPANAS_AUTO_SEND_ENABLED=false
